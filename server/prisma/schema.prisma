// Per ADR-005 (one owning service per entity) and PHASE_1_CT_SPEC.md §4's
// "one schema per module": Identity & Access and Event & Catalogue get
// separate Postgres schemas in this shared Phase-1 instance. No FK crosses
// a schema boundary (ProducerApplication.accountId, Festival.producerAccountId
// are plain UUID columns, validated in application code, not the DB).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalogue", "inventory", "orders", "survey", "internalops"]
}

model Account {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  // Null until POST /api/account/verify-email succeeds. LP-14: a survey
  // submission creates the Account in this pending state, never
  // immediately "verified" — PHASE_1_CT_SPEC.md's End User page reads this.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  roleAssignments        RoleAssignment[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  credential              Credential?

  @@schema("identity")
}

// PHASE_1_IO_INCREMENT_SPEC.md §4 (revised 2026-08-24) — ONE credential
// store for every human who can sign in, whatever they are: fan, producer,
// Platform Admin, or Internal Ops staff. Replaces the short-lived
// internalops.StaffCredential (staff-only) built earlier the same session,
// and the two password-less stand-ins (Platform Admin's email-only login,
// the Producer portal's no-login-at-all) — Nitish's explicit call: one real
// login, RBAC decides what you see afterwards. An Account may still exist
// with no Credential (guest checkout, survey-created accounts before they
// set a password), so this is a separate table, not a column on Account.
model Credential {
  id           String   @id @default(uuid())
  accountId    String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@schema("identity")
}

// LP-14 email verification — stubbed adapter (server/src/identity/
// emailVerification.ts), no real provider chosen yet (PHASE_1_CT_SPEC.md
// §8-territory TBD). One row per verification attempt; `usedAt` makes a
// token single-use without deleting the audit trail of attempts.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  accountId String
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@schema("identity")
}

model Role {
  id  String @id @default(uuid())
  key String @unique // fan | producer | platform_admin

  assignments RoleAssignment[]

  @@schema("identity")
}

model RoleAssignment {
  id          String    @id @default(uuid())
  accountId   String
  roleId      String
  grantedAt   DateTime  @default(now())
  grantedBy   String?
  // A suspended assignment is kept (not deleted) so grant history survives
  // a suspend/reinstate cycle — requireAuth excludes it from the account's
  // active roles while suspendedAt is set. PR-1's "approve/reject/suspend"
  // triad (spec §2).
  suspendedAt DateTime?
  suspendedBy String?

  account Account @relation(fields: [accountId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([accountId, roleId])
  @@schema("identity")
}

model Session {
  id        String   @id @default(uuid())
  accountId String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id])

  @@schema("identity")
}

// PR-1 acceptance criterion: every approve/reject/suspend action is
// recorded here (actor/target/timestamp/reason). Append-only by convention
// — no update/delete route exists in the API for this model.
model AuditLogEntry {
  id         String   @id @default(uuid())
  actorLabel String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorLabel])
  @@schema("identity")
}

enum ProducerApplicationStatus {
  pending
  approved
  rejected

  @@schema("catalogue")
}

model ProducerApplication {
  id             String                    @id @default(uuid())
  accountId      String
  producerName   String
  organisation   String
  email          String
  festivalName   String
  status         ProducerApplicationStatus @default(pending)
  submittedAt    DateTime                  @default(now())
  decidedAt      DateTime?
  decidedBy      String?
  decisionReason String?

  @@index([accountId])
  @@index([status])
  @@schema("catalogue")
}

model Festival {
  id                String    @id @default(uuid())
  producerAccountId String
  name              String
  startDate         DateTime
  endDate           DateTime
  venue             String
  description       String?
  createdAt         DateTime  @default(now())

  events Event[]

  @@index([producerAccountId])
  @@schema("catalogue")
}

// Event & Catalogue beyond Festival (spec §2) — read path only for Phase 1:
// producer/admin-entered, not synced from an external feed. Event is a
// dated session within a Festival (e.g. one day / one stage); Venue, Zone,
// Artist and SeatMap are the supporting catalogue entities Ticketing &
// Inventory will read from in a later sub-slice.
model Venue {
  id        String   @id @default(uuid())
  name      String
  city      String
  country   String
  capacity  Int
  createdAt DateTime @default(now())

  events   Event[]
  seatMap  SeatMap?

  @@schema("catalogue")
}

model SeatMap {
  id        String   @id @default(uuid())
  venueId   String   @unique
  // Object storage product is [TBD: PHASE_1_CT_SPEC.md §8] — stores a URL to
  // wherever the asset actually lives once that's decided, not the asset
  // itself.
  imageUrl  String
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id])

  @@schema("catalogue")
}

model Artist {
  id        String   @id @default(uuid())
  name      String
  genre     String?
  createdAt DateTime @default(now())

  lineups EventArtist[]

  @@schema("catalogue")
}

model Event {
  id          String   @id @default(uuid())
  festivalId  String
  venueId     String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  description String?
  createdAt   DateTime @default(now())

  festival Festival      @relation(fields: [festivalId], references: [id])
  venue    Venue         @relation(fields: [venueId], references: [id])
  zones    Zone[]
  lineup   EventArtist[]

  @@index([festivalId])
  @@index([venueId])
  @@schema("catalogue")
}

model EventArtist {
  id       String @id @default(uuid())
  eventId  String
  artistId String

  event  Event  @relation(fields: [eventId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([eventId, artistId])
  @@schema("catalogue")
}

// Zone is Event & Catalogue's read model of a ticketing zone (e.g. GA,
// VIP) — capacity and price tier only. TicketType/Allocation/Hold (the
// actual sellable inventory) belong to the Ticketing & Inventory module,
// a later sub-slice; Zone just gives it something to reference.
model Zone {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  capacity  Int
  priceTier String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@schema("catalogue")
}

// ---------------------------------------------------------------------
// Ticketing & Inventory (spec §2/§4 — extracted service in production;
// Phase 1 keeps it as its own Postgres schema in the shared dev instance,
// per ADR-005 one-owner-per-entity — no FK crosses into `catalogue` or
// `orders`, TicketType.zoneId / Hold.cartId etc. are plain UUID columns
// validated in application code). Hold-then-issue model, no overselling
// (ADR-007): Allocation.remaining is only ever changed by an atomic
// conditional UPDATE (`remaining >= quantity`), never read-then-write.
// ---------------------------------------------------------------------

model TicketType {
  id                String   @id @default(uuid())
  zoneId            String
  name              String
  priceMinorUnits   Int
  currency          String   @default("EUR")
  createdAt         DateTime @default(now())

  allocation Allocation?
  holds      Hold[]
  tickets    Ticket[]

  @@index([zoneId])
  @@schema("inventory")
}

// One row per TicketType. `remaining` is the sellable count net of active
// holds and issued tickets — decremented on hold, restored on
// release/expiry, never touched on issue (issuing just converts a hold
// that already decremented it).
model Allocation {
  id            String   @id @default(uuid())
  ticketTypeId  String   @unique
  totalQuantity Int
  remaining     Int
  updatedAt     DateTime @updatedAt

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@schema("inventory")
}

enum HoldStatus {
  active
  converted
  released
  expired

  @@schema("inventory")
}

// A temporary reservation against Allocation.remaining. Cart items map 1:1
// to an active Hold; checkout converts holds to Tickets, abandonment
// releases them back. `expiresAt` is enforced lazily (checked/reclaimed on
// the next allocation-touching call) rather than a background job — see
// PROGRESS.md for that scoping note.
model Hold {
  id           String     @id @default(uuid())
  ticketTypeId String
  cartId       String
  quantity     Int
  status       HoldStatus @default(active)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]

  @@index([ticketTypeId])
  @@index([cartId])
  @@schema("inventory")
}

// Issued on successful checkout, one row per unit purchased. `qrCode` is a
// unique opaque token standing in for a real scannable asset — object
// storage/QR rendering product is [TBD: PHASE_1_CT_SPEC.md §8].
model Ticket {
  id          String   @id @default(uuid())
  ticketTypeId String
  holdId      String
  orderId     String
  orderLineId String
  holderName  String?
  qrCode      String   @unique @default(uuid())
  issuedAt    DateTime @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  hold       Hold       @relation(fields: [holdId], references: [id])

  @@index([orderId])
  @@schema("inventory")
}

// ---------------------------------------------------------------------
// Orders & Cart (spec §2/§4 — monolith module, orchestrates in-process
// calls to Ticketing & Inventory and the stub Payment adapter, ADR-006).
// A Cart is guest-usable (`accountId` nullable) per J1. Fee itemisation
// uses a placeholder rate — see `server/src/orders/pricing.ts`, no real
// fee schedule exists in the PRD yet.
// ---------------------------------------------------------------------

enum CartStatus {
  open
  checked_out
  abandoned

  @@schema("orders")
}

model Cart {
  id        String     @id @default(uuid())
  accountId String?
  status    CartStatus @default(open)
  createdAt DateTime   @default(now())

  items CartItem[]
  order Order?

  @@index([accountId])
  @@schema("orders")
}

model CartItem {
  id                 String   @id @default(uuid())
  cartId             String
  ticketTypeId       String
  holdId             String
  quantity           Int
  unitPriceMinorUnits Int
  createdAt          DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
  @@schema("orders")
}

enum OrderStatus {
  pending
  paid
  failed
  refunded

  @@schema("orders")
}

// Itemised per ADR-006/spec §2: subtotal + fee shown separately, matching
// exit check 3 ("cart shows an itemised fee breakdown").
model Order {
  id                   String      @id @default(uuid())
  cartId               String      @unique
  accountId            String?
  guestEmail           String?
  guestName            String?
  subtotalMinorUnits   Int
  feeMinorUnits        Int
  totalMinorUnits      Int
  currency             String      @default("EUR")
  status               OrderStatus @default(pending)
  paymentIntentId      String?
  createdAt            DateTime    @default(now())

  cart  Cart        @relation(fields: [cartId], references: [id])
  lines OrderLine[]

  @@index([accountId])
  @@schema("orders")
}

model OrderLine {
  id                  String   @id @default(uuid())
  orderId             String
  ticketTypeId        String
  quantity            Int
  unitPriceMinorUnits Int
  createdAt           DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@schema("orders")
}

// ---------------------------------------------------------------------
// Survey (spec §2, LP-14) — own module (ADR-005), no FK into `identity`;
// `accountId` is a plain UUID validated in application code, same pattern
// as every other cross-module reference in this codebase.
// ---------------------------------------------------------------------

model SurveyResponse {
  id        String   @id @default(uuid())
  accountId String
  answers   Json
  createdAt DateTime @default(now())

  @@index([accountId])
  @@schema("survey")
}

// ---------------------------------------------------------------------
// Internal Ops Console (build/MVP2_InternalOps/PHASE_1_IO_SPEC.md) — a
// separate system from the ticketing product (ADR-005: own schema, no FK
// into `identity`; StaffProfile.accountId is a plain UUID). `personName`
// is an implementation addition beyond the spec's literal model (the
// spec's §2 lists names per role in prose) — captured as data so the
// Founder rollup/CTO roster widgets can render real names, per Nitish's
// 2026-08-24 confirmation that real names may be committed to this repo.
// ---------------------------------------------------------------------

model OrgRole {
  id                String   @id @default(uuid())
  key               String   @unique
  title             String
  department        String?
  personName        String?
  reportsToOrgRoleId String?
  createdAt         DateTime @default(now())

  reportsTo OrgRole?  @relation("OrgRoleReports", fields: [reportsToOrgRoleId], references: [id])
  reports   OrgRole[] @relation("OrgRoleReports")

  capabilities  OrgRoleCapability[]
  staffProfiles StaffProfile[]

  @@index([reportsToOrgRoleId])
  @@schema("internalops")
}

model Capability {
  id          String @id @default(uuid())
  key         String @unique
  description String

  orgRoles OrgRoleCapability[]

  @@schema("internalops")
}

model OrgRoleCapability {
  id           String @id @default(uuid())
  orgRoleId    String
  capabilityId String

  orgRole    OrgRole    @relation(fields: [orgRoleId], references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  @@unique([orgRoleId, capabilityId])
  @@schema("internalops")
}

// One row per staff login — links an identity.Account (plain UUID, no
// FK) to an OrgRole. Deliberately not identity.RoleAssignment: that's
// the product's fan/producer/platform_admin RBAC axis, a different
// concern (spec §5).
model StaffProfile {
  id          String   @id @default(uuid())
  accountId   String   @unique
  orgRoleId   String
  displayName String
  createdAt   DateTime @default(now())

  orgRole OrgRole @relation(fields: [orgRoleId], references: [id])

  @@index([accountId])
  @@schema("internalops")
}

// NOTE: internalops.StaffCredential was created earlier this same session
// and removed again before it ever shipped — superseded by
// identity.Credential (see its comment), once Nitish chose one unified
// login for every persona rather than a staff-only password store beside
// two password-less stand-ins. Recorded here rather than silently
// vanishing, since its migration is still in the history.
